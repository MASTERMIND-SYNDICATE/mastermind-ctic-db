###############################################################################
# Open-CTIC ETL Container
#
# Multi-stage build that installs Python dependencies in a builder stage
# and copies only the necessary artifacts to a slim runtime image.
###############################################################################

# -- Builder ------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build
COPY etl/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# -- Runtime ------------------------------------------------------------------
FROM python:3.12-slim

LABEL maintainer="Open-CTIC <https://github.com/MASTERMIND-SYNDICATE/open-ctic>"
LABEL description="ETL pipeline for MISP and Wazuh ingestion"

# Copy installed packages from builder.
COPY --from=builder /install /usr/local

WORKDIR /app
COPY etl/ ./etl/
COPY infra/etl/mock/ ./etl/mock/

# Run as non-root.
RUN useradd --system --no-create-home etl
USER etl

ENTRYPOINT ["python", "-u"]
CMD ["-m", "etl.misp_pull"]
