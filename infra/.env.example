###############################################################################
# Open-CTIC Environment Configuration
#
# Copy this file to .env and fill in real values before running
# docker compose up.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
###############################################################################

# -- PostgreSQL ---------------------------------------------------------------
PGUSER=ctic
PGPASSWORD=changeme                       # REQUIRED — set a strong password
PGDATABASE=cticdb
PG_HOST_PORT=55432                        # Host port mapped to Postgres

# -- Grafana ------------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme               # Change after first login
GRAFANA_PORT=3000

# -- pgAdmin ------------------------------------------------------------------
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=8080

# -- MISP Integration ---------------------------------------------------------
MISP_URL=                                 # e.g. https://misp.example.com
MISP_KEY=                                 # MISP API auth key
MISP_VERIFY_SSL=false                     # Set true for production
MISP_TAGS=                                # Comma-separated tag filter
MISP_SINCE_DAYS=7                         # Look-back window in days
MISP_LIMIT=100                            # Max attributes per pull

# -- Wazuh Integration (optional) --------------------------------------------
WAZUH_URL=                                # e.g. https://wazuh.example.com:55000
WAZUH_USER=
WAZUH_PASS=
WAZUH_INSECURE=false                      # true for self-signed certs (dev only)
WAZUH_QUERY_MINUTES=60                    # Look-back window
WAZUH_LIMIT=500                           # Max events per fetch
WAZUH_SRC=wazuh                           # Source system label

# -- ETL Runtime --------------------------------------------------------------
ETL_INTERVAL_SEC=300                      # MISP pull loop interval (seconds)
